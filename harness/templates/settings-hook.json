{
  "_comment": "挂载段模板：合并进项目 .claude/settings.json 的 hooks 对象（保留已有事件）。ENGINE_PATH 改为本机 claude-sdlc-skills checkout 的绝对路径。",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ENGINE_PATH/harness/engine/check.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
